# Clean-URL rewrite for Apache / LiteSpeed shared hosts (Hostinger, XAMPP).
# Mirrors router.php, which does the same job under PHP's built-in server.

DirectoryIndex index.html
Options -MultiViews

# Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript application/json application/ld+json image/svg+xml
</IfModule>

# Browser caching (CSS/JS use ?v= query strings, so a bump busts the cache)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType video/mp4 "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType text/javascript "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

RewriteEngine On

# 301: old capitalised live URLs -> lowercase (Linux hosts are case-sensitive).
# Must stay above the generic rules below; the optional .html is absorbed here.
RewriteRule ^Dormitory-in-kodaikanal(\.html)?/?$ /dormitory-in-kodaikanal [R=301,L]
RewriteRule ^Groupstay-in-kodaikanal(\.html)?/?$ /groupstay-in-kodaikanal [R=301,L]
RewriteRule ^Kodaikanal-2-days-tour-package(\.html)?/?$ /kodaikanal-2-days-tour-package [R=301,L]
RewriteRule ^Resorts-in-kodaikanal(\.html)?/?$ /resorts-in-kodaikanal [R=301,L]
RewriteRule ^Tentstay-in-kodaikanal(\.html)?/?$ /tentstay-in-kodaikanal [R=301,L]
RewriteRule ^Terms-and-conditions(\.html)?/?$ /terms-and-conditions [R=301,L]
RewriteRule ^Travels-in-kodaikanal(\.html)?/?$ /travels-in-kodaikanal [R=301,L]

# 301: live pages that have no local page yet -> closest existing page.
# Remove a rule once its real page is built. Must stay above the generic rules below.
# Resorts
RewriteRule ^green-hills-resort-in-kodaikanal(\.html)?/?$ /resorts-in-kodaikanal [R=301,L]
RewriteRule ^ksk-resort-kodaikanal(\.html)?/?$ /resorts-in-kodaikanal [R=301,L]
RewriteRule ^olive-garden-resort-in-kodaikanal(\.html)?/?$ /resorts-in-kodaikanal [R=301,L]
RewriteRule ^lazo-eucy-resort-kodaikanal(\.html)?/?$ /resorts-in-kodaikanal [R=301,L]
RewriteRule ^moon-light-resort-kodaikanal(\.html)?/?$ /resorts-in-kodaikanal [R=301,L]
RewriteRule ^hillside-retreat-in-kodaikanal(\.html)?/?$ /resorts-in-kodaikanal [R=301,L]
RewriteRule ^poombarai-resorts(\.html)?/?$ /resorts-in-kodaikanal [R=301,L]
# Villas
RewriteRule ^vacation-villa-in-kodaikanal(\.html)?/?$ /villas-in-kodaikanal [R=301,L]
RewriteRule ^kalpana-cottage-kodaikanal(\.html)?/?$ /villas-in-kodaikanal [R=301,L]
RewriteRule ^blooming-villa-in-kodaikanal(\.html)?/?$ /villas-in-kodaikanal [R=301,L]
