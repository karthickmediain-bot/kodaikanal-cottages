RewriteRule ^ragavendra-cottage-kodaikanal(\.html)?/?$ /villas-in-kodaikanal [R=301,L]
RewriteRule ^sankar-cottage-kodaikanal(\.html)?/?$ /villas-in-kodaikanal [R=301,L]
# Hotels
RewriteRule ^hotel-mount-view-kodaikanal(\.html)?/?$ /hotels-in-kodaikanal [R=301,L]
RewriteRule ^lakshmi-residency-in-kodaikanal(\.html)?/?$ /hotels-in-kodaikanal [R=301,L]
# Lodges
RewriteRule ^royal-adventure-in-kodaikanal(\.html)?/?$ /lodges-in-kodaikanal [R=301,L]
RewriteRule ^dream-ville-cottage-in-kodaikanal(\.html)?/?$ /lodges-in-kodaikanal [R=301,L]
# Tent stay
RewriteRule ^kodai-outdoor-valley-kodaikanal(\.html)?/?$ /tentstay-in-kodaikanal [R=301,L]
# Group stay
RewriteRule ^happy-points-cottage-in-kodaikanal(\.html)?/?$ /groupstay-in-kodaikanal [R=301,L]
