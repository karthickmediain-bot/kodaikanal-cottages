RewriteRule ^cottages-in-kodaikanal-for-group-stay(\.html)?/?$ /groupstay-in-kodaikanal [R=301,L]
RewriteRule ^villas-in-kodaikanal-for-group-stay(\.html)?/?$ /groupstay-in-kodaikanal [R=301,L]
